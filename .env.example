# Orion Brain Bridge Configuration

# Required: Anthropic API key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model to use (default: claude-sonnet-4-20250514)
MODEL=claude-sonnet-4-20250514

# Orion's personality and memory (paste contents directly)
# These are loaded at runtime to give phone-Orion full context

SOUL_MD=
MEMORY_MD=
USER_MD=
IDENTITY_MD=
